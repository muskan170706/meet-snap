{
  "manifest_version": 3,
  "name": "MeetSnap",
  "version": "1.0.0",
  "description": "Google Meet camera interception extension with red tint canvas pipeline.",
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
